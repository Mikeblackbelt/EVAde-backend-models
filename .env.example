# EVAde API configuration: variable NAMES only. Put real values in your shell or the deployment's secret store,
# never in this file or the repo.
# Shared API key, 32+ characters, sent in the X-EVAde-Key header (Secret Manager on Cloud Run)
EVADE_API_KEY=
# "1": serve /docs, /redoc, /openapi.json (behind the key); "1": reject X-Forwarded-Proto: http
EVADE_ENABLE_DOCS=
EVADE_REQUIRE_HTTPS=
EVADE_MODEL_DIR=
EVADE_ALLOW_DRAFT=
# Storage: memory (default) or cloudflare
EVADE_STORAGE=
EVADE_STORE_RAW_WINDOWS=
EVADE_STORAGE_DEADLINE_S=
# Cloudflare D1 (API token permission: Account > D1 > Edit)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Cloudflare R2 data bucket: raw windows, exports (R2 API token: Object Read & Write on this bucket only)
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_ENDPOINT=
# Cloudflare R2 models bucket (scripts/fetch_models.py)
CF_R2_MODELS_BUCKET=
# "1" only for local experiments: models/ in the data bucket with its read-write key
EVADE_ALLOW_SHARED_MODELS_BUCKET=
# servers: Object Read only
CF_R2_MODELS_ACCESS_KEY_ID=
CF_R2_MODELS_SECRET_ACCESS_KEY=
# training machines only, never on a server: Object Read & Write
CF_R2_MODELS_WRITE_ACCESS_KEY_ID=
CF_R2_MODELS_WRITE_SECRET_ACCESS_KEY=
# Legacy model folders without manifest.json: pinned sha256 of model.joblib (unset: served as unverified)
EVADE_LEGACY_SHA256_SEIZURE=
EVADE_LEGACY_SHA256_ECG=
# Training: commit recorded in manifest.json when the tree has no .git
EVADE_CODE_COMMIT=
