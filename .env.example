# EVAde API configuration: variable NAMES only. Put real values in your shell or the deployment's secret store,
# never in this file or the repo.
EVADE_API_TOKEN=
EVADE_CORS_ORIGINS=
EVADE_MODEL_DIR=
EVADE_ALLOW_DRAFT=
# Storage: memory (default) or cloudflare
EVADE_STORAGE=
EVADE_STORE_RAW_WINDOWS=
# Cloudflare D1 (API token permission: Account > D1 > Edit)
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_D1_DATABASE_ID=
# Cloudflare R2 (R2 API token: Object Read & Write on the bucket)
CF_R2_BUCKET=
CF_R2_ACCESS_KEY_ID=
CF_R2_SECRET_ACCESS_KEY=
CF_R2_ENDPOINT=
# Training: commit recorded in manifest.json when the tree has no .git
EVADE_CODE_COMMIT=
